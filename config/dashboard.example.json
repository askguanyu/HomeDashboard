{
  "timezone": "America/New_York",
  "locale": "zh-CN",
  "theme": {
    "mode": "dark",
    "background": "mix",
    "backgroundMarket": "en-US",
    "backgroundImage": null,
    "changeColors": "green-up"
  },
  "location": { "zip": "90210", "name": "Your City, ST" },
  "widgets": [
    {
      "id": "analog",
      "type": "analog-clock",
      "area": { "col": [1, 4], "row": [1, 3] },
      "options": { "style": "ring", "secondsHand": true }
    },
    {
      "id": "tape",
      "type": "stocks",
      "area": { "col": [4, 13], "row": [1, 3] },
      "options": {
        "style": "tape",
        "columnsPerRow": 6,
        "quotesPerRow": 3,
        "symbols": [
          { "code": "AAPL" },
          { "code": "AMZN" },
          { "code": "SPY" },
          { "code": "^VIX" },
          { "code": "GLD" },
          { "code": "USO" },
          { "code": "XAUUSD=X" },
          { "code": "EURUSD=X" },
          { "code": "JPY=X" },
          { "code": "CAD=X" },
          { "code": "BTC-USD", "label": "BTC" },
          { "code": "ETH-USD", "label": "ETH" }
        ]
      }
    },
    {
      "id": "clock",
      "type": "clock",
      "area": { "col": [1, 7], "row": [3, 5] },
      "options": { "seconds": true, "dateLine": true, "lunar": false }
    },
    {
      "id": "weather",
      "type": "weather",
      "area": { "col": [1, 7], "row": [5, 8] },
      "options": {
        "details": ["sunrise", "wind", "humidity", "pressure", "visibility"],
        "forecastDays": 5,
        "units": "metric"
      }
    },
    {
      "id": "calendar",
      "type": "calendar",
      "area": { "col": [7, 13], "row": [3, 8] },
      "options": {
        "months": 2,
        "weekNumbers": true,
        "showHolidays": true,
        "icsUrls": [],
        "eventsFile": "config/events.json"
      }
    }
  ]
}
